extends SceneTree

func _init() -> void:
	var account_script = load("res://scripts/accounts/account_manager.gd")
	var account = account_script.new()
	account.load_or_create_profile()
	assert(account.profile.has("player_id"))
	assert(account.profile.get("provider") == "offline")
	assert(account.validate_display_name("Explorador"))
	assert(not account.validate_display_name("AB"))
	assert(not account.validate_display_name("EsteNombreEsDemasiadoLargoParaElLimite"))
	assert(account.set_display_name("Explorador"))
	assert(account.create_local_profile("Piloto_Aurora"))
	assert(account.profile.get("display_name") == "Piloto_Aurora")
	assert(account.profile.get("provider") == "offline")
	assert(account.profile.get("schema_version") == 3)
	assert(account.profile.has("created_at"))
	assert(not account.is_google_linked())
	assert(not account.set_display_name(""))
	account.begin_google_sign_in()
	assert(not account.is_google_linked())
	# La identidad local se debe poder recuperar desde el backup si el JSON principal se daña.
	var corrupt_file := FileAccess.open(account.PROFILE_PATH, FileAccess.WRITE)
	assert(corrupt_file != null)
	corrupt_file.store_string("{ perfil corrupto")
	corrupt_file.close()
	var restored = account.load_or_create_profile()
	assert(restored.get("provider") == "offline")
	assert(restored.get("player_id", "") != "")
	assert(restored.get("display_name", "") != "")
	var settings_script = load("res://scripts/core/settings_manager.gd")
	var settings = settings_script.new()
	assert(settings.set_setting("master_volume", 2.0))
	assert(is_equal_approx(settings.get_setting("master_volume"), 1.0))
	assert(settings.set_setting("camera_sensitivity", 0.0))
	assert(is_equal_approx(settings.get_setting("camera_sensitivity"), 0.25))
	assert(not settings.set_setting("unknown_option", true))
	settings.reset_settings()
	print("ACCOUNT_SETTINGS_TESTS_OK")
	quit()

extends SceneTree

const GameStateScript = preload("res://scripts/core/game_state.gd")
const InventoryScript = preload("res://scripts/resources/inventory.gd")
const TradeManagerScript = preload("res://scripts/economy/trade_manager.gd")
const GameLoopScript = preload("res://scripts/gameplay/game_loop_manager.gd")

var passed := 0
var failed := 0

func _initialize() -> void:
	call_deferred("_run_tests")

func _check(condition: bool, label: String) -> void:
	if condition:
		passed += 1
		print("PASS: ", label)
	else:
		failed += 1
		push_error("FAIL: " + label)

func _run_tests() -> void:
	var state = GameStateScript.new()
	_check(state.resources["metal"] == 0, "new state starts with zero metal")
	state.add_resource("metal", 25)
	_check(state.resources["metal"] == 25, "add_resource adds positive amount")
	state.add_resource("metal", -10)
	_check(state.resources["metal"] == 25, "add_resource ignores negative amount")
	_check(state.can_afford({"metal": 20}), "affordability true when balance covers cost")
	_check(not state.can_afford({"metal": 30}), "affordability false when balance insufficient")
	_check(state.spend({"metal": 10}), "spend succeeds when affordable")
	_check(state.resources["metal"] == 15, "spend deducts exact amount")
	_check(not state.spend({"metal": 20}), "spend fails without enough resources")
	_check(state.resources["metal"] == 15, "failed spend does not alter balance")
	_check(not state.can_afford({"metal": -5}), "negative cost rejected")
	_check(not state.spend({"metal": -5}), "negative spend rejected")
	_check(state.resources["metal"] == 15, "negative spend cannot mint resources")
	state.unlock_region("test_region")
	state.unlock_region("test_region")
	_check(state.unlocked_regions.count("test_region") == 1, "region unlock is idempotent")
	_check(state.base_level == 1 and state.titan_level == 1, "default progression levels are valid")
	_check(state.resources.has("energy") and state.resources.has("crystal"), "resource dictionary includes all core resources")
	var signal_counter := [0]
	state.resources_changed.connect(func(): signal_counter[0] += 1)
	state.add_resource("crystal", 3)
	_check(signal_counter[0] == 1, "resource changes emit one signal")
	var SaveManagerScript = preload("res://scripts/core/save_manager.gd")
	var save_manager = SaveManagerScript.new()
	state.base_level = 3
	state.titan_level = 4
	state.unlock_region("test_region_2")
	_check(save_manager.save_game(state), "save_game returns success")
	var loaded_state = GameStateScript.new()
	_check(save_manager.load_game(loaded_state), "load_game returns success for valid save")
	_check(loaded_state.resources["metal"] == 15 and loaded_state.resources["crystal"] == 3, "save/load preserves resource values")
	_check(loaded_state.base_level == 3 and loaded_state.titan_level == 4, "save/load preserves progression levels")
	_check(loaded_state.unlocked_regions.has("test_region_2"), "save/load preserves unlocked regions")
	_check(save_manager.save_profile({"profile_name": "test", "credits": 123, "flags": ["qa"]}), "save_profile accepts valid snapshot")
	var loaded_profile: Dictionary = save_manager.load_profile()
	_check(loaded_profile.get("version", 0) == 2, "profile save/load preserves version metadata")
	_check(loaded_profile.get("credits", -1) == 123, "profile save/load preserves credits field")
	_check(save_manager.save_profile({"profile_name":"backup_test","credits":321}), "second profile write creates recoverable backup")
	var corrupt_file := FileAccess.open(SaveManagerScript.PROFILE_PATH, FileAccess.WRITE)
	if corrupt_file:
		corrupt_file.store_string("{ invalid json")
		corrupt_file.close()
	var recovered_profile: Dictionary = save_manager.load_profile()
	_check(recovered_profile.get("credits", -1) == 123, "profile loader recovers previous backup when current JSON is corrupt")
	_check(FileAccess.file_exists(SaveManagerScript.PROFILE_PATH), "backup recovery restores profile file on disk")
	_check(loaded_profile.get("flags", []).has("qa"), "profile save/load preserves custom snapshot fields")
	var state_after_profile_save = GameStateScript.new()
	_check(save_manager.load_game(state_after_profile_save), "game save remains readable after profile save")
	_check(state_after_profile_save.resources["metal"] == 15, "profile save no longer overwrites game save")
	
	var legacy_profile_file := FileAccess.open(SaveManagerScript.PROFILE_PATH, FileAccess.WRITE)
	if legacy_profile_file:
		legacy_profile_file.store_string(JSON.stringify({"version": 1, "credits": 77, "research_data": 8, "resources": {"metal": 12}, "custom_flag": "kept"}))
		legacy_profile_file.close()
	var migrated_profile: Dictionary = save_manager.load_profile()
	_check(migrated_profile.get("version", 0) == 2, "legacy profile v1 is normalized to v2")
	_check(migrated_profile.get("credits", -1) == 77 and migrated_profile.get("research_data", -1) == 8, "profile migration preserves legacy progress values")
	_check(migrated_profile.get("base_level", 0) == 1 and migrated_profile.get("campaign_level", 0) == 1, "profile migration fills missing progression defaults")
	_check(migrated_profile.get("custom_flag", "") == "kept", "profile migration retains unknown legacy fields")
	var unsupported_profile_file := FileAccess.open(SaveManagerScript.PROFILE_PATH, FileAccess.WRITE)
	if unsupported_profile_file:
		unsupported_profile_file.store_string(JSON.stringify({"version": 99, "credits": 500}))
		unsupported_profile_file.close()
	_check(save_manager.load_profile().is_empty(), "profile loader rejects unsupported future versions")

	var loop_manager = GameLoopScript.new()
	root.add_child(loop_manager)
	_check(not loop_manager.active_mission.is_empty(), "integrated game loop starts tutorial mission")
	_check(not loop_manager.start_expedition("broken_isles", "cristal", 4, {}), "expedition rejects locked region")
	var mission_rewards := [{}]
	loop_manager.mission_completed.connect(func(_id: String, reward: Dictionary): mission_rewards[0] = reward)
	loop_manager.report_collection("metal", 2)
	_check(loop_manager.mission_progress_value == 2, "mission progress tracks collected matching resource")
	loop_manager.report_collection("cristal", 3)
	_check(loop_manager.mission_progress_value == 2, "mission ignores non-target resource")
	loop_manager.report_collection("metal", 3)
	_check(loop_manager.active_mission.is_empty(), "starter mission completes at its target")
	_check(loop_manager.completed_missions.has("starter_gather"), "completed mission is recorded for anti-repeat")
	_check(mission_rewards[0].get("research_data", 0) == 3, "mission completion emits reward payload")
	_check(loop_manager.is_region_unlocked("broken_isles"), "starter mission unlocks next region")
	_check(loop_manager.travel_to("broken_isles"), "travel works for unlocked region")
	_check(not loop_manager.travel_to("deep_trench"), "travel rejects locked region")
	_check(loop_manager.start_expedition("broken_isles", "cristal", 4, {"metal": 6}), "expedition starts in unlocked region")
	loop_manager.report_collection("cristal", 2)
	_check(int(loop_manager.active_expedition.get("progress", 0)) == 2, "expedition progress persists between collection events")
	loop_manager.report_collection("cristal", 2)
	_check(loop_manager.active_expedition.is_empty(), "expedition completes and clears active state")
	loop_manager.start_random_event()
	var event_resource := str(loop_manager.active_event.get("resource", ""))
	_check(not event_resource.is_empty() and loop_manager.get_event_bonus(event_resource) > 0, "regional event applies resource-specific bonus")
	_check(loop_manager.get_event_bonus("not_event_resource") == 0, "regional event bonus does not affect unrelated resource")
	var loop_snapshot: Dictionary = loop_manager.export_state()
	var restored_loop = GameLoopScript.new()
	restored_loop.import_state(loop_snapshot)
	_check(restored_loop.current_region == "broken_isles", "loop save restores current region")
	_check(restored_loop.completed_missions.has("starter_gather"), "loop save restores mission completion history")
	_check(restored_loop.active_event.get("id", "") == loop_manager.active_event.get("id", ""), "loop save restores active event")
	loop_manager.free()
	restored_loop.free()

	var inventory = InventoryScript.new()
	inventory.add_item("metal", 5)
	_check(inventory.has_items({"metal": 5}), "inventory confirms sufficient item quantity")
	_check(not inventory.has_items({"metal": -2}), "inventory rejects negative costs")
	_check(not inventory.remove_items({"metal": -2}), "inventory refuses negative-cost removal")
	_check(inventory.items["metal"] == 5, "invalid inventory transaction does not mint items")
	_check(inventory.remove_items({"metal": 3}), "inventory removes valid cost")
	_check(inventory.items["metal"] == 2, "inventory deducts exact amount")
	var trade = TradeManagerScript.new()
	trade.credits = 0
	var wallet := {"metal": 0, "energia": 0, "cristal": 0}
	_check(not trade.buy_good("metal", -1, wallet), "market rejects negative quantity")
	_check(not trade.buy_good("cristal", 100, wallet), "market rejects purchase beyond stock")
	_check(not trade.buy_good("cristal", 1, wallet), "market rejects purchase without enough credits")
	trade.add_credits(100)
	_check(trade.buy_good("metal", 2, wallet), "market accepts affordable valid purchase")
	_check(wallet["metal"] == 2 and trade.credits == 76, "purchase updates inventory and wallet exactly")
	_check(trade.sell_good("metal", 1, wallet), "market accepts valid sale")
	_check(wallet["metal"] == 1 and trade.credits == 83, "sale updates inventory and wallet exactly")
	var partial_state = GameStateScript.new()
	partial_state.resources = {"metal": 9}
	_check(save_manager.save_game(partial_state), "save_game supports partial legacy resource snapshots")
	var restored_partial = GameStateScript.new()
	_check(save_manager.load_game(restored_partial), "load accepts partial resource snapshots")
	_check(restored_partial.resources.has("energy") and restored_partial.resources["energy"] == 0, "load restores default keys missing from snapshot")
	state.free()
	loaded_state.free()
	state_after_profile_save.free()
	partial_state.free()
	restored_partial.free()
	save_manager.free()
	trade.free()
	print("CORE TESTS: ", passed, " passed, ", failed, " failed")
	quit(1 if failed > 0 else 0)
